POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator_pass
POSTGRES_DB=orchestrator

APP_ENV=development
DB_HOST=postgres
DB_PORT=5432
DB_USER=orchestrator
DB_PASSWORD=orchestrator_pass
DB_NAME=orchestrator

REDIS_HOST=redis
REDIS_PORT=6379

DISCOVERY_TYPE=static               
STATIC_AGENTS_FILE=/app/config/agents.json

LLM_ENDPOINT=http://ollama:11434/api/chat
LLM_MODEL=llama3.2:latest

OLLAMA_KEEP_ALIVE=-1
OLLAMA_LOAD_TIMEOUT=300
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1